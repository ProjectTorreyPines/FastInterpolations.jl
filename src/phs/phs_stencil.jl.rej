 const _PHS_COEFF_CACHE_MAX = 5_000
 
-# We use a task-local Dict to store stencil coefficients. This ensures
-# thread-safety without locks, as each task (thread) gets its own cache.
+# We use a thread-local array of Dicts to store stencil coefficients. 
+# This ensures thread-safety without locks, and persists across multiple
+# `Threads.@threads` calls (unlike task_local_storage).
+const _PHS_COEFF_CACHES = Dict{UInt, Vector{Any}}()
+
 @inline function _phs_get_coeff_cache(
         itp::PHSInterpolantND{Tg, Tv, N, K},
     ) where {Tg, Tv, N, K}
-    store = task_local_storage()
     itp_id = objectid(itp)
-    cache  = get(store, itp_id, nothing)
-    if cache === nothing
-        cache = Dict{NTuple{N, Int}, Vector{Tg}}()
-        store[itp_id] = cache
-    end
-    return cache::Dict{NTuple{N, Int}, Vector{Tg}}
+    # This is safe because we only mutate it with a lock if the itp_id is missing,
+    # and then each thread operates on its own index.
+    caches = get!(_PHS_COEFF_CACHES, itp_id) do
+        [Dict{NTuple{N, Int}, Vector{Tg}}() for _ in 1:Threads.nthreads()]
+    end
+    tid = Threads.threadid()
+    return caches[tid]::Dict{NTuple{N, Int}, Vector{Tg}}
 end
 
